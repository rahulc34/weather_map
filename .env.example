# Copy to .env and fill in. Never commit .env.

# Google Gemini (free tier key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the model (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# OpenWeather (free key: https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=

PORT=8080
NODE_ENV=development

# Optional: extra comma-separated origins allowed by CORS (dev server is allowed automatically outside production)
ALLOWED_ORIGINS=
